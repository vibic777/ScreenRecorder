
QWidget { background-color: #fff0f5; color: #4a1829; }
QLabel, QCheckBox { background: transparent; }
QMainWindow, QDialog { background-color: #fff0f5; }
QPushButton { background: #ffffff; border: 1px solid #e4b2c3; border-radius: 5px; padding: 7px 12px; }
QPushButton:hover { background: #ffd9e5; border-color: #c43d70; }
QPushButton:pressed { background: #c43d70; color: white; }
QPushButton:default { border: 2px solid #c43d70; }
QPushButton:focus, QComboBox:focus, QLineEdit:focus { border: 2px solid #c43d70; }
QPushButton:disabled, QComboBox:disabled, QLineEdit:disabled { color: #8c6875; background: #fff0f5; border-color: #e4b2c3; }
QLineEdit, QComboBox, QSpinBox { background: #ffffff; border: 1px solid #e4b2c3; border-radius: 4px; padding: 6px; selection-background-color: #c43d70; selection-color: white; }
QComboBox QAbstractItemView { background: #ffffff; color: #4a1829; selection-background-color: #c43d70; selection-color: white; }
QMenuBar, QMenu { background: #ffffff; color: #4a1829; }
QMenu { border: 1px solid #e4b2c3; padding: 4px; }
QMenu::item { padding: 7px 24px; }
QMenu::item:selected, QMenuBar::item:selected { background: #c43d70; color: white; }
QMenu::separator { height: 1px; background: #e4b2c3; margin: 4px; }
QCheckBox { spacing: 7px; }
QCheckBox::indicator { width: 14px; height: 14px; border: 1px solid #e4b2c3; border-radius: 3px; background: #ffffff; }
QCheckBox::indicator:checked { background: #c43d70; border: 2px solid #4a1829; }
QToolTip { background: #ffffff; color: #4a1829; border: 1px solid #e4b2c3; padding: 4px; }
